PORT=5000
# Supabase Database URL (Project Settings -> Database -> Connection String -> URI)
# Direct connection (Recommended for Prisma):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Or Connection Pooler (if port 5432 is blocked):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

JWT_SECRET="your_jwt_secret_key_12345"
